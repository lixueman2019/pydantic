    // -- Tool Registration ------------------------------------------------------
    private void RegisterCapabilities(McpRequestHandler handler)
    {
        // 1. list_assets
        handler.AddTool("list_assets",
            "List the wind turbine generators at a site with their current operating state. Use when the user asks what assets exist at a location, or which turbines are running, stopped, curtailed, or alarming.",
            schemaConfig: s => s.String("site", "Optional exact filter on site", required: false),
            handler: async (args, ct) =>
            {
                var site = args.Value<string>("site");
                var results = new JArray();
                foreach (var record in Assets)
                {
                    if (string.IsNullOrEmpty(site) || record["site"]?.ToString() == site)
                        results.Add(JObject.Parse(record.ToString()));
                }
                return new JObject { ["assets"] = results };
            });

        // 2. get_asset_status
        handler.AddTool("get_asset_status",
            "Return the current operating state, any active alarm codes, and the latest sensor readings for one turbine. Use when the user asks how a specific turbine is doing right now or whether it is alarming.",
            schemaConfig: s => s.String("asset_id", "Exact value of id to look up", required: true),
            handler: async (args, ct) =>
            {
                var asset_id = args.Value<string>("asset_id") ?? "";
                foreach (var record in Assets)
                {
                    if (record["id"]?.ToString() == asset_id)
                        return JObject.Parse(record.ToString());
                }
                throw new ArgumentException($"No assets record found for \"{asset_id}\".");
            });

        // 3. query_telemetry
        handler.AddTool("query_telemetry",
            "Return a time series for one sensor metric on one turbine between two timestamps. Available metrics: gearbox_temp_c, vibration_rms_mm_s, power_output_kw, wind_speed_ms, rotor_rpm. Use when the user asks about trends, history, or how a reading has changed over time.",
            schemaConfig: s => s.String("asset_id", "Turbine id", required: true).String("metric", "One of: gearbox_temp_c, vibration_rms_mm_s, power_output_kw, wind_speed_ms, rotor_rpm.", required: true).String("from", "Start of the window as an ISO date", required: true).String("to", "End of the window as an ISO date", required: true),
            handler: async (args, ct) =>
            {
                var assetId  = (args.Value<string>("asset_id") ?? "").Trim();
                var metric   = (args.Value<string>("metric") ?? "").Trim();
                var fromText = (args.Value<string>("from") ?? "").Trim();
                var toText   = (args.Value<string>("to") ?? "").Trim();
                var inv = System.Globalization.CultureInfo.InvariantCulture;
                var styles = System.Globalization.DateTimeStyles.None;
                
                DateTime fromDate, toDate;
                if (!DateTime.TryParse(fromText, inv, styles, out fromDate) ||
                    !DateTime.TryParse(toText, inv, styles, out toDate))
                {
                    return new JObject {
                        ["error"] = "invalid_range",
                        ["message"] = "Provide from and to as ISO dates, for example 2026-06-16."
                    };
                }
                if (toDate < fromDate)
                {
                    return new JObject {
                        ["error"] = "invalid_range",
                        ["message"] = "The to date is earlier than the from date. Swap them and retry."
                    };
                }
                
                // The deliberate failure Use Case 3 turns on. A Standard-harness
                // plan halts here; the agent loop reads this message, narrows or
                // splits the window, and finishes the task -- which only works
                // because the message says what to do rather than just refusing.
                if ((toDate - fromDate).TotalDays > 90)
                {
                    return new JObject {
                        ["error"] = "range_too_large",
                        ["message"] = "Maximum query window is 90 days. Narrow the range and retry."
                    };
                }
                
                foreach (var record in Telemetry)
                {
                    if (record["asset_id"]?.ToString() != assetId) continue;
                    if (record["metric"]?.ToString() != metric) continue;
                
                    var points = new JArray();
                    foreach (var pt in (JArray)record["points"])
                    {
                        DateTime ts;
                        if (!DateTime.TryParse(pt["ts"]?.ToString(), inv, styles, out ts)) continue;
                        if (ts < fromDate || ts > toDate) continue;
                        points.Add(pt.DeepClone());
                    }
                
                    return new JObject {
                        ["asset_id"] = assetId,
                        ["metric"] = metric,
                        ["unit"] = record["unit"]?.ToString(),
                        ["from"] = fromDate.ToString("yyyy-MM-dd"),
                        ["to"] = toDate.ToString("yyyy-MM-dd"),
                        ["point_count"] = points.Count,
                        ["points"] = points
                    };
                }
                
                return new JObject {
                    ["error"] = "not_found",
                    ["message"] = $"No telemetry series for asset '{assetId}' and metric '{metric}'. Available metrics: gearbox_temp_c, vibration_rms_mm_s, power_output_kw, wind_speed_ms, rotor_rpm."
                };
            });
    }
}

