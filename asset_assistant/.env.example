# Non-secret placeholders only. No API key, token or password.
# Copy to asset_assistant/.env for persistence; that exact path is auto-loaded.
# Process environment takes precedence, including explicitly empty values. Restart after editing.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com/openai/responses?api-version=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-pro
AZURE_OPENAI_MODEL=gpt-5.4-pro
# Blank here: use the exact api-version from the Responses URI above; never guessed.
# For a resource root endpoint, set a verified API version explicitly.
AZURE_OPENAI_API_VERSION=
# Full /openai/responses URI selects Responses automatically.
# With a root endpoint, set responses explicitly; blank preserves legacy Chat Completions.
AZURE_OPENAI_API_MODE=
ASSET_ASSISTANT_PORT=8000
# Optional bounded budgets; defaults apply even when these lines remain commented.
# Whole run: identity, all model requests/retries/backoff, local tools and streaming (1..1800 s).
# ASSET_ASSISTANT_RUN_TIMEOUT_SECONDS=600
# SDK HTTP phase/inactivity wait (1..600 s), capped to the whole-run budget; connect <=10 s.
# ASSET_ASSISTANT_REQUEST_TIMEOUT_SECONDS=300
# Additional SDK retries (0..2); never retries the entire chat. 0 avoids SDK replay.
# ASSET_ASSISTANT_REQUEST_MAX_RETRIES=1
# Invalid/empty/out-of-range knobs fall back to defaults. Restart to apply.